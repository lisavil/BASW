+void Graph::refreshSmallIncidentScores(dynscan::Vertex *vertex) {
+    if (vertex->isLarge()) {
+        return;
+    }
+    for (int i = 0; i < vertex->getDegree(); ++i) {
+        const int neighbor_id = vertex->getNeighborID(i);
+        auto *neighbor = (dynscan::Vertex *) vList[neighbor_id - 1];
+        if (neighbor->isLarge()) {
+            continue;
+        }
+        const double score = myJaccard->compute_similarity(*vertex, *neighbor);
+        vertex->updateNeighborSimScore(score, neighbor_id);
+        neighbor->updateNeighborSimScore(score, vertex->id);
+    }
+}
